PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:8444,http://localhost:8444
TIGER_DATA_HOST=
TIGER_DATA_PORT=5432
TIGER_DATA_USER=tsdbadmin
TIGER_DATA_PASSWORD=
TIGER_DATA_DATABASE=tsdb
# TLS certificate verification is enabled. Optional custom certificate authority:
TIGER_DATA_CA_FILE=
# Only disable TLS/Timescale for a local plain PostgreSQL development database.
TIGER_DATA_SSL=true
# Prefer a CA file. Set false only when your hosted service presents a chain
# that Node cannot validate; traffic remains encrypted when SSL stays true.
TIGER_DATA_SSL_REJECT_UNAUTHORIZED=true
TIGER_DATA_TIMESCALE=true
MAX_PDF_SIZE_BYTES=10485760
# Must match the frontend Firebase project. Keep the service account JSON outside the repo.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
