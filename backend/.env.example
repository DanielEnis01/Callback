PORT=3001
HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_REQUEST_TIMEOUT_MS=5000
BACKBOARD_MIN_INTERVAL_MS=250
# npm run dev enables test identities and the developer endpoints locally.
# Mock is the frontend dev default; choose Live in the panel to use real APIs.
CALLBACK_DEV_TOOLS=0
BACKBOARD_MODE=live
# Optional locally; required in production. Run npm run db:migrate first.
DATABASE_URL=
# Required to accept Firebase Bearer tokens in production.
FIREBASE_PROJECT_ID=
