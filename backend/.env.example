PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8444,http://localhost:8444
TIGER_DATA_HOST=
TIGER_DATA_PORT=5432
TIGER_DATA_USER=tsdbadmin
TIGER_DATA_PASSWORD=
TIGER_DATA_DATABASE=tsdb
# TLS certificate verification is enabled. Optional custom certificate authority:
TIGER_DATA_CA_FILE=
# Only disable TLS/Timescale for a local plain PostgreSQL development database.
TIGER_DATA_SSL=true
# Prefer a CA file. Set false only when your hosted service presents a chain
# that Node cannot validate; traffic remains encrypted when SSL stays true.
TIGER_DATA_SSL_REJECT_UNAUTHORIZED=true
TIGER_DATA_TIMESCALE=true
MAX_PDF_SIZE_BYTES=10485760
# Must match the frontend Firebase project. Keep the service account JSON outside the repo.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini (recruiter conversation) + ElevenLabs (TTS voice + STT transcription).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set true to skip real ElevenLabs TTS calls and get silent audio back instead
# (handy for testing the pipeline without burning API quota).
USE_MOCK_TTS=false

# Python speech-analysis service (STAR method / quantification / filler words).
# Spawned automatically by the backend on startup (see services/pythonAnalysis.js).
ANALYSIS_SERVICE_PORT=5055

# Backboard — semantic memory across sessions (see services/backboard.js).
# Without a key the memory layer is skipped entirely and sessions behave
# exactly as they did before it existed.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_MIN_INTERVAL_MS=250
BACKBOARD_REQUEST_TIMEOUT_MS=5000
