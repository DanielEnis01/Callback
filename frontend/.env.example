# Copy this file to .env and replace the placeholder with your SmartSpectra key.
# Vite only exposes variables prefixed with VITE_ to the renderer.
VITE_SMARTSPECTRA_API_KEY=your_smartspectra_api_key_here

# Backend address for browser and Electron requests. Backboard's key stays in backend/.env.
VITE_API_BASE_URL=http://localhost:3001
