{
  "name": "callback-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "PATH=/opt/homebrew/opt/node@22/bin:$PATH concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@smartspectra/node-sdk": "^3.3.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.1"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "study.callback.desktop",
    "productName": "Callback",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@smartspectra/node-sdk-linux-*/**"
    ],
    "asarUnpack": [
      "**/node_modules/@smartspectra/**",
      "**/node_modules/koffi/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "files": [
        "!node_modules/@smartspectra/node-sdk-win32-*/**"
      ]
    },
    "afterSign": "scripts/afterSignAdHoc.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DanielEnis01",
        "repo": "Callback",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Callback-Setup-${version}.${ext}"
    }
  }
}
